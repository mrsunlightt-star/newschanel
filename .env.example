# 复制为 .env 后填写（.env 已被 gitignore，不会进仓库）
# Actions 环境则改用仓库的 Secrets / Variables 注入同名变量

# --- Telegram（必填）---
# @BotFather 创建 bot 后获得 token；把 bot 加为频道管理员
TELEGRAM_BOT_TOKEN=
# 频道 ID：公开频道填 @用户名，私有频道填 -100 开头的数字 ID
TELEGRAM_CHAT_ID=

# --- LLM（必填，任意 OpenAI 兼容接口）---
# 免费档推荐：Groq https://console.groq.com 或 OpenRouter https://openrouter.ai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# LLM_MAX_TOKENS=950  # 输出预算：推理模型的思考也计入；Groq 免费档 qwen3.8-27b 上限 1000，须低于它

# --- 可选 ---
# RSS_FEEDS=https://hnrss.org/frontpage,https://techcrunch.com/feed/
# FETCH_HOURS=6
# MAX_POSTS_PER_RUN=5
# SEND_INTERVAL=3
# SHOW_LINK_PREVIEW=0
# CARD_MODE=auto      # 卡片形态：auto 有图走媒体卡片/无图走纯文字紧凑卡片（默认）；
                      #           text 全部纯文字（不抓图，最快）；image 全部尽力带图
# COVER_ASPECT=16:9   # 封面统一裁成宽幅卡片（0:0 = 保持原图比例，仅 image 模式）
# COVER_WIDTH=1280    # 裁剪后目标宽度（像素，仅 image 模式）
# 帖子底部导航行（逗号分隔多项，每项「名称|链接」，名称可含 emoji；留空不显示）
# CHANNEL_LINKS=📢 频道|https://t.me/techscinew,👥 群组|https://t.me/xxx,📝 投稿|https://t.me/xxx
